import numpy as np
from scipy.linalg import solve_continuous_are
from tqdm import tqdm
import matplotlib.pyplot as plt

# =========================================================
# 1. 물리 엔진 (Headless Mode - 시각화 없이 연산 전용)
# =========================================================
class CraneSimulation:
    def __init__(self):
        self.M = 3800.0; self.m_hook = 500.0; self.m_cont = 30000.0 
        self.current_m = self.m_hook + self.m_cont # 무거운 화물 기준
        self.g = 9.81; self.dt = 0.02
        self.L = 10.0
        
        # 상태: [x, vx, th, w] (1D 모델로 단순화하여 최적화 속도 향상)
        self.state = np.zeros(4) 
        
        # [고정 상수] R은 이전 실험에서 찾은 최적값 사용
        self.R = np.array([[1e-6]]) 
        self.Q = np.eye(4) # 튜너가 계속 바꿀 예정

    def get_gain(self):
        # LQR Gain 계산
        L_safe = max(self.L, 1.0); m = self.current_m 
        A = np.array([[0, 1, 0, 0], 
                      [0, 0, m*self.g/self.M, 0], 
                      [0, 0, 0, 1], 
                      [0, 0, -(self.M+m)*self.g/(self.M*L_safe), 0]])
        B = np.array([[0], [1/self.M], [0], [-1/(self.M*L_safe)]])
        
        try:
            P = solve_continuous_are(A, B, self.Q, self.R)
            K = np.linalg.inv(self.R) @ B.T @ P
            return K
        except:
            return np.zeros((1, 4))

    def run_trial(self, duration=15.0, target_dist=15.0):
        # 시뮬레이션 실행 및 비용(Cost) 반환
        self.state = np.zeros(4) # 초기화
        K = self.get_gain()
        
        total_pos_error = 0.0
        total_sway_energy = 0.0
        max_overshoot = 0.0
        
        steps = int(duration / self.dt)
        target = np.array([target_dist, 0, 0, 0])
        
        for _ in range(steps):
            # 상태 분해
            x, v, th, w = self.state
            
            # 제어 입력
            error = self.state - target
            u = -K @ error
            force = np.clip(u[0], -400000, 400000)
            
            # 물리 업데이트 (Euler Method for speed)
            m, M, g, L = self.current_m, self.M, self.g, self.L
            denom = L * (M + m - m * np.cos(th)**2)
            
            th_acc = (-force*np.cos(th) - (M+m)*g*np.sin(th)) / denom
            x_acc = (force + m*np.sin(th)*(-g*np.cos(th))) / (M + m - m * np.cos(th)**2)
            
            # 오일러 적분
            self.state[0] += v * self.dt
            self.state[1] += x_acc * self.dt
            self.state[2] += w * self.dt
            self.state[3] += th_acc * self.dt
            
            # 1. 위치 오차 누적 (절대값)
            total_pos_error += abs(target_dist - x)
            
            # 2. 흔들림 에너지 누적 (각도^2 + 각속도^2)
            total_sway_energy += (th**2 + 0.1 * w**2)
            
            # 3. 오버슈트 체크 (목표지점 15m를 얼마나 넘었나)
            if x > target_dist:
                max_overshoot = max(max_overshoot, x - target_dist)

        return total_pos_error, total_sway_energy, max_overshoot

# =========================================================
# 2. 최적화 파이프라인 (그래프 데이터 반환하도록 수정됨)
# =========================================================

def optimize_stage_1_velocity():
    print("\n[1단계] 트롤리 주행성 최적화 (x vs v)...")
    
    q_pos = 500.0
    candidates = np.linspace(1.0, 100.0, 50) 
    
    best_qv = 10.0
    best_score = float('inf')
    
    # 그래프용 데이터 저장소
    history_qv = []
    history_score = []
    
    sim = CraneSimulation()
    
    for qv in tqdm(candidates):
        sim.Q = np.diag([q_pos, qv, 10000.0, 1000.0]) # Sway는 무시
        p_err, s_err, overshoot = sim.run_trial()
        
        # 점수: 위치오차 + 오버슈트 페널티
        score = p_err + (overshoot * 5000.0)
        
        if score < best_score:
            best_score = score
            best_qv = qv
        
        history_qv.append(qv)
        history_score.append(score)
            
    print(f"-> 1단계 완료: 최적 Q_vel = {best_qv:.2f}")
    return best_qv, history_qv, history_score

def optimize_stage_2_damping_ratio(best_qv):
    print("\n[2단계] 펜듈럼 댐핑 비율 최적화 (theta vs theta_dot)...")
    
    q_pos = 500.0
    q_vel = best_qv
    q_sway_temp = 1000000.0 
    
    ratios = np.linspace(0.01, 1.0, 50)
    
    best_ratio = 0.1
    best_sway_energy = float('inf')
    
    history_ratio = []
    history_energy = []
    
    sim = CraneSimulation()
    
    for r in tqdm(ratios):
        q_sway_vel = q_sway_temp * r
        sim.Q = np.diag([q_pos, q_vel, q_sway_temp, q_sway_vel])
        
        _, sway_energy, _ = sim.run_trial()
        
        if sway_energy < best_sway_energy:
            best_sway_energy = sway_energy
            best_ratio = r
            
        history_ratio.append(r)
        history_energy.append(sway_energy)
            
    print(f"-> 2단계 완료: 최적 Damping Ratio = {best_ratio:.3f}")
    return best_ratio, history_ratio, history_energy

def optimize_stage_3_balance(best_qv, best_ratio):
    print("\n[3단계] 전체 밸런스 최적화 (Position vs Sway)...")
    
    q_pos = 500.0
    sway_weights = np.logspace(4, 8, 50) 
    
    results_pos = []
    results_sway = []
    results_w = []
    
    sim = CraneSimulation()
    
    for w in tqdm(sway_weights):
        q_sway_vel = w * best_ratio 
        sim.Q = np.diag([q_pos, best_qv, w, q_sway_vel])
        
        p_err, s_err, _ = sim.run_trial()
        results_pos.append(p_err)
        results_sway.append(s_err)
        results_w.append(w)
        
    # Knee Point 계산
    rp = np.array(results_pos); rs = np.array(results_sway)
    norm_p = (rp - rp.min()) / (rp.max() - rp.min())
    norm_s = (rs - rs.min()) / (rs.max() - rs.min())
    
    dists = np.sqrt(norm_p**2 + norm_s**2)
    best_idx = np.argmin(dists)
    best_w = results_w[best_idx]
    
    print(f"-> 3단계 완료: 최적 Q_sway = {best_w:.1f}")
    return best_w, results_sway, results_pos, results_w, best_idx

# =========================================================
# 3. 메인 실행 및 그래프 출력 (저장 기능 추가됨)
# =========================================================
if __name__ == "__main__":
    print("=== LQR 3-Stage Automatic Tuner Start ===")
    
    # 1단계 실행
    final_qv, h1_qv, h1_score = optimize_stage_1_velocity()
    
    # 2단계 실행
    final_ratio, h2_ratio, h2_energy = optimize_stage_2_damping_ratio(final_qv)
    
    # 3단계 실행
    final_qsway, h3_sway, h3_pos, h3_w, best_idx = optimize_stage_3_balance(final_qv, final_ratio)
    
    final_qsway_vel = final_qsway * final_ratio
    
    # --- [그래프 그리기] ---
    fig, axes = plt.subplots(1, 3, figsize=(18, 5))
    plt.subplots_adjust(wspace=0.3)
    
    # Plot 1: Velocity Optimization
    axes[0].plot(h1_qv, h1_score, 'b-')
    axes[0].plot(final_qv, min(h1_score), 'ro', label=f'Best Qv={final_qv:.1f}')
    axes[0].set_title("Stage 1: Velocity Tuning")
    axes[0].set_xlabel("Q_velocity")
    axes[0].set_ylabel("Cost (Error + Overshoot)")
    axes[0].grid(True)
    axes[0].legend()

    # Plot 2: Damping Ratio Optimization
    axes[1].plot(h2_ratio, h2_energy, 'g-')
    axes[1].plot(final_ratio, min(h2_energy), 'ro', label=f'Best Ratio={final_ratio:.2f}')
    axes[1].set_title("Stage 2: Damping Ratio Tuning")
    axes[1].set_xlabel("Ratio (Q_w / Q_th)")
    axes[1].set_ylabel("Total Sway Energy")
    axes[1].grid(True)
    axes[1].legend()

    # Plot 3: Balance (Pareto) Optimization
    sc = axes[2].scatter(h3_sway, h3_pos, c=np.log10(h3_w), cmap='viridis')
    axes[2].plot(h3_sway, h3_pos, 'k--', alpha=0.3)
    # 최적점 표시
    axes[2].plot(h3_sway[best_idx], h3_pos[best_idx], 'r*', markersize=15, label='Optimal Balance')
    
    axes[2].set_title("Stage 3: Position vs Sway (Pareto)")
    axes[2].set_xlabel("Sway Error (Stability)")
    axes[2].set_ylabel("Position Error (Accuracy)")
    axes[2].set_xscale('log') # 로그 스케일 적용
    axes[2].grid(True, which="both", ls="--", alpha=0.5)
    axes[2].legend()
    fig.colorbar(sc, ax=axes[2], label='Log10(Q_sway)')

    print("\n그래프를 저장합니다...")
    
    # [수정] 그래프 저장 명령어 추가
    # 실행하면 폴더에 'LQR_Optimization_Result.png' 파일이 생깁니다.
    plt.savefig('LQR_Optimization_Result.png', dpi=300, bbox_inches='tight')
    
    print("-> 저장 완료. 화면에도 출력합니다.")
    plt.show()

    print("\n==========================================")
    print("       🎉 최적화 완료! 최종 결과 🎉       ")
    print("==========================================")
    print(f"self.Q_sub = np.diag([500.0, {final_qv:.2f}, {final_qsway:.1f}, {final_qsway_vel:.1f}])")
    print("==========================================")
